REFAAT_ENVIRONMENT=development
REFAAT_DATABASE_URL=sqlite:///./data/refaat.db
REFAAT_AUTO_CREATE_SCHEMA=true
REFAAT_BLOB_BACKEND=local
REFAAT_BLOB_ROOT=./data/blobs
REFAAT_API_KEY_PEPPER=replace-with-a-long-random-secret
REFAAT_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
REFAAT_TRUSTED_HOSTS=["localhost","127.0.0.1"]
REFAAT_CORS_ORIGINS=[]
REFAAT_EMBEDDING_PROVIDER=deterministic
REFAAT_EMBEDDING_MODEL=refaat-hash-v1
REFAAT_EMBEDDING_DIMENSIONS=384
REFAAT_GENERATION_PROVIDER=extractive
REFAAT_GRAPH_PROVIDER=cooccurrence
REFAAT_OTEL_ENABLED=false
REFAAT_LOG_JSON=true
