# Oronts Knowledge Terminal environment. Every value has a safe default; the app runs
# fully offline with none of these set.

# Where the SQLite database and blobs live. In the container this is the mounted volume.
DATA_DIR=./data/showcase

# Optional. When set, generation and embeddings switch to the OpenAI REST API. Leave
# empty to stay on the offline deterministic stack (hash embeddings, extractive answers).
# REFAAT_OPENAI_API_KEY=
# REFAAT_OPENAI_BASE_URL=https://api.openai.com/v1
# REFAAT_GENERATION_MODEL=gpt-4o-mini
# REFAAT_EMBEDDING_MODEL=text-embedding-3-small
# REFAAT_EMBEDDING_DIMENSIONS=1536

# Retrieval feature toggles. All default on and degrade to the deterministic default.
# REFAAT_HYPE_ENABLED=true
# REFAAT_RAPTOR_ENABLED=true
# REFAAT_CONTEXTUAL_RETRIEVAL=true

# Abstention floor for the online path only. An out-of-corpus question whose best
# retrieved cosine similarity is below this value returns an honest no-answer instead of
# a stitched answer. Default 0.3 online. Forced to 0.0 (disabled) offline, because
# hash-embedding scores are not comparable to a real cosine threshold.
# REFAAT_ABSTAIN_BELOW_SCORE=0.3

# Server port inside the container.
PORT=8000
