POSTGRES_PASSWORD=replace-with-at-least-24-random-characters
REDIS_PASSWORD=replace-with-at-least-24-random-characters
OBJECT_STORE_ACCESS_KEY_ID=refaat
OBJECT_STORE_SECRET_ACCESS_KEY=replace-with-at-least-24-random-characters
REFAAT_API_KEY_PEPPER=replace-with-at-least-32-random-characters
REFAAT_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
REFAAT_BIND_ADDRESS=127.0.0.1
REFAAT_PORT=8000

# Pin image digests for a controlled production rollout.
POSTGRES_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:7-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.29
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0

# Secure-by-default egress governance (off by default). Set the policy to "allowlist" and list every
# provider host the runtime may reach; a configured model, embedding, or fine-tuning base_url host
# not on the list fails startup. Each entry is {host, port?, schemes?, purposes?}.
# REFAAT_EGRESS_POLICY=allowlist
# REFAAT_EGRESS_ALLOWLIST=[{"host": "api.openai.com", "port": 443, "schemes": ["https"], "purposes": ["model", "fine_tuning"]}]
